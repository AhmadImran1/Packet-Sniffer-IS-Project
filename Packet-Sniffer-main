import tkinter as tk
from scapy.all import sniff, IP, TCP, UDP, Raw, get_if_list
import logging
import threading

# Configure logging
logging.basicConfig(filename='packet_sniffer.log', level=logging.INFO, format='%(asctime)s - %(message)s')

class PacketSnifferApp:
    def __init__(self, master):
        self.master = master
        self.master.title("Packet Sniffer")
        self.is_sniffing = False
        self.filter_protocol = 'TCP'  # Default filter is TCP
        self.filter_ip = None  # No IP filter by default

        # Start/Stop Sniffing Buttons
        self.start_button = tk.Button(master, text="Start Sniffing", command=self.start_sniffing)
        self.start_button.grid(row=0, column=0, padx=10, pady=10)

        self.stop_button = tk.Button(master, text="Stop Sniffing", command=self.stop_sniffing, state=tk.DISABLED)
        self.stop_button.grid(row=0, column=1, padx=10, pady=10)

        # Protocol Filter Dropdown
        self.protocol_label = tk.Label(master, text="Select Protocol:")
        self.protocol_label.grid(row=1, column=0, pady=5, sticky="e")
        self.protocol_var = tk.StringVar(master)
        self.protocol_var.set("TCP")
        self.protocol_menu = tk.OptionMenu(master, self.protocol_var, "TCP", "UDP", "HTTP")
        self.protocol_menu.grid(row=1, column=1, pady=5)

        # IP Filter Entry
        self.ip_label = tk.Label(master, text="Filter by IP (Optional):")
        self.ip_label.grid(row=2, column=0, pady=5, sticky="e")
        self.ip_entry = tk.Entry(master)
        self.ip_entry.grid(row=2, column=1, pady=5)

        # Apply Filters Button
        self.apply_filters_button = tk.Button(master, text="Apply Filters", command=self.apply_filters)
        self.apply_filters_button.grid(row=3, column=0, columnspan=2, pady=10)

        # Output Textbox
        self.output_text = tk.Text(master, height=15, width=70)
        self.output_text.grid(row=4, column=0, columnspan=2, padx=10, pady=10)

        # Save Output Button
        self.save_button = tk.Button(master, text="Save Output", command=self.save_output)
        self.save_button.grid(row=6, column=0, columnspan=2, pady=10)

        # Interface Selection Dropdown
        self.create_interface_dropdown()

    def create_interface_dropdown(self):
        """Creates a dropdown to select the network interface."""
        interfaces = self.get_active_interface()
        self.interface_label = tk.Label(self.master, text="Select Interface:")
        self.interface_label.grid(row=5, column=0, pady=5, sticky="e")
        self.interface_var = tk.StringVar(self.master)
        self.interface_var.set(interfaces[0] if interfaces else "None")
        self.interface_menu = tk.OptionMenu(self.master, self.interface_var, *interfaces)
        self.interface_menu.grid(row=5, column=1, pady=5)

    def apply_filters(self):
        """Applies selected filters for protocol and IP."""
        self.filter_protocol = self.protocol_var.get()
        self.filter_ip = self.ip_entry.get() if self.ip_entry.get() else None
        self.output_text.insert(tk.END, f"Filters applied: Protocol={self.filter_protocol}, IP={self.filter_ip}\n")
        self.output_text.see(tk.END)

    def packet_callback(self, packet):
        """Handles incoming packets and updates the UI."""
        
        if IP in packet:
            ip_layer = packet[IP]
            if self.filter_ip and ip_layer.src != self.filter_ip and ip_layer.dst != self.filter_ip:
                return  # Skip packet if it doesn't match the IP filter

            # Process the packet based on the selected protocol
            if self.filter_protocol == 'TCP' and TCP in packet:
                packet_info = self.process_packet(ip_layer, packet[TCP])
            elif self.filter_protocol == 'UDP' and UDP in packet:
                packet_info = self.process_packet(ip_layer, packet[UDP])
            elif self.filter_protocol == 'HTTP' and Raw in packet:
                packet_info = self.process_http_packet(ip_layer, packet)

            if packet_info:
                self.output_text.insert(tk.END, packet_info)
                self.output_text.see(tk.END)  # Scroll to the end
    
    def process_packet(self, ip_layer, transport_layer):
        """Process non-HTTP packets (TCP, UDP)."""
        return f"Source: {ip_layer.src}, Destination: {ip_layer.dst}, Protocol: {transport_layer._class.name_}, Size: {len(transport_layer)}\n"

    def process_http_packet(self, ip_layer, packet):
        """Process HTTP requests."""
        payload = packet[Raw].load.decode(errors='ignore')

        if "GET" in payload or "POST" in payload:
            request_line = payload.splitlines()[0]
            url_path = self.extract_url(request_line)

            # Extract Host header
            host = self.extract_host_header(payload)

            # Build the full URL
            if host:
                url = f"http://{host}{url_path}"  # Assume HTTP scheme
            else:
                url = f"http://{ip_layer.dst}{url_path}"  # Fallback to IP if Host header is not available

            self.log_http_request(request_line, url)

            return f"HTTP Request: {request_line} | URL: {url}\n"

    def extract_url(self, request_line):
        """Extract URL from HTTP request."""
        parts = request_line.split(' ')
        if len(parts) > 1:
            return parts[1]  # Extract URL (second part of the request line)
        return "No URL Found"

    def extract_host_header(self, payload):
        """Extract the Host header from the HTTP request."""
        lines = payload.splitlines()
        for line in lines:
            if line.lower().startswith("host:"):
                # Return the host part of the Host header
                return line.split(":")[1].strip()
        return None  # Return None if Host header is not found

    def log_http_request(self, request_line, url):
        """Log HTTP request to the file with URL."""
        logging.info(f"HTTP Request: {request_line} | URL: {url}")

    def save_output(self):
        """Saves the output to a file."""
        try:
            with open("sniffed_packets.txt", "w") as file:
                file.write(self.output_text.get(1.0, tk.END))
            self.output_text.insert(tk.END, "Output saved to sniffed_packets.txt\n")
        except Exception as e:
            self.output_text.insert(tk.END, f"Error saving output: {str(e)}\n")

    def start_sniffing(self):
        """Starts sniffing packets in a new thread."""
        self.selected_interface = self.interface_var.get()
        if self.selected_interface:
            self.is_sniffing = True
            self.start_button.config(state=tk.DISABLED)
            self.stop_button.config(state=tk.NORMAL)
            self.output_text.delete(1.0, tk.END)  # Clear previous output
            threading.Thread(target=self.sniff_packets, daemon=True).start()
        else:
            self.output_text.insert(tk.END, "No active network interface found!\n")

    def stop_sniffing(self):
        """Stops sniffing and disables the stop button."""
        self.is_sniffing = False
        self.start_button.config(state=tk.NORMAL)
        self.stop_button.config(state=tk.DISABLED)

    def sniff_packets(self):
        """Uses Scapy to sniff packets from the selected interface."""
        try:
            self.output_text.insert(tk.END, f"Sniffing packets on interface: {self.selected_interface}\n")
            self.output_text.see(tk.END)  # Scroll to the end
            while self.is_sniffing:
                sniff(iface=self.selected_interface, prn=self.packet_callback, store=0, timeout=1)  # Add timeout to prevent blocking
        except Exception as e:
            self.output_text.insert(tk.END, f"Error occurred while sniffing: {str(e)}\n")

    def get_active_interface(self):
        """Finds the active network interface."""
        interfaces = get_if_list()
        if not interfaces:
            self.output_text.insert(tk.END, "No network interfaces found!\n")        
        return interfaces

if __name__ == "__main__":
    root = tk.Tk()
    app = PacketSnifferApp(root)
    root.mainloop()
